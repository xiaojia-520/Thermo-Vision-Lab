<Window x:Class="ThermoVision.Camera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermo Vision Camera" Height="540" Width="920" MinHeight="480" MinWidth="760">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="14" Background="#F2F4F7" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="相机 IP" />
        <TextBox Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding CameraIp, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="2" Margin="12,0,0,0" Padding="16,6" Command="{Binding ConnectCommand}" Content="连接" />
        <Button Grid.Column="3" Margin="8,0,0,0" Padding="16,6" Command="{Binding DisconnectCommand}" Content="断开" />
        <TextBlock Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding ConnectionStatus}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,18,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <Border Background="#1B1B1B" CornerRadius="6">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock FontSize="22" Foreground="White" HorizontalAlignment="Center" Text="实时热图区域" />
          <TextBlock Margin="0,8,0,0" Foreground="#D0D0D0" HorizontalAlignment="Center" Text="待 Yoseen SDK 温度流接入后显示画面" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="18,0,0,0" Padding="14" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前帧" />
          <TextBlock Margin="0,16,0,0" Text="中心温度" />
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding CenterTemperatureText}" />
          <TextBlock Margin="0,16,0,0" Text="发射率" />
          <TextBox Text="{Binding Emissivity, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,16,0,0" Text="最后采集时间" />
          <TextBlock TextWrapping="Wrap" Text="{Binding LastCaptureTimeText}" />
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#667085" Text="第一版：相机独立采集架构（x64），尚未写入设备配置。" />
      <Button DockPanel.Dock="Right" Padding="18,7" Command="{Binding CaptureCommand}" Content="保存采集元数据" />
    </DockPanel>
  </Grid>
</Window>
