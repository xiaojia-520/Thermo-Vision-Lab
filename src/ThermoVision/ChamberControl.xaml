<UserControl x:Class="ThermoVision.ChamberControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#DDE4ED"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="22"/>
        </Style>
        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#718096"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>
        <Style x:Key="ValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#17233A"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDE4ED"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Width="78"
                        Height="36"
                        VerticalAlignment="Center"
                        Content="← 返回"
                        Foreground="#33445E"
                        Background="#EEF2F7"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="实验舱监控与控制"
                               Foreground="#17233A"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,5,0,0"
                               Text="TOMILO · Modbus TCP · 192.168.1.30:8000"
                               Foreground="#718096"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Padding="10,5"
                            Background="#E9F7EF"
                            CornerRadius="12">
                        <TextBlock Text="监控与控制"
                                   Foreground="#26734A"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Ellipse x:Name="ConnectionDot"
                             Width="9"
                             Height="9"
                             Margin="18,0,8,0"
                             Fill="#A0AEC0"/>
                    <TextBlock x:Name="ConnectionText"
                               VerticalAlignment="Center"
                               Text="正在连接"
                               Foreground="#52627A"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="32,24,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    BorderBrush="#F3C8BA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前温度"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="CurrentTemperatureText"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="--.- ℃"
                               Foreground="#C65337"
                               FontSize="31"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TemperatureSetpointText"
                               Grid.Row="2"
                               Text="设定值：--.- ℃"
                               Foreground="#718096"
                               FontSize="12"/>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    BorderBrush="#BFD8F7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前湿度"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="CurrentHumidityText"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="--.- %RH"
                               Foreground="#276EF1"
                               FontSize="31"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="HumiditySetpointText"
                               Grid.Row="2"
                               Text="设定值：--.- %RH"
                               Foreground="#718096"
                               FontSize="12"/>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="运行概况"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="RunStateText"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="等待设备数据"
                               Foreground="#17233A"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="PhaseText"
                               Grid.Row="2"
                               Text="温度：--　湿度：--"
                               Foreground="#718096"
                               FontSize="12"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="实验舱控制"
                               Foreground="#17233A"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="目标温度（℃）"
                                       Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TemperatureSetpointTextBox"
                                         Height="30"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="SetTemperatureButton"
                                        Grid.Column="2"
                                        Height="30"
                                        Content="写入温度"
                                        IsEnabled="False"
                                        Click="SetTemperatureButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="目标湿度（%RH）"
                                       Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HumiditySetpointTextBox"
                                         Height="30"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="SetHumidityButton"
                                        Grid.Column="2"
                                        Height="30"
                                        Content="写入湿度"
                                        IsEnabled="False"
                                        Click="SetHumidityButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartChamberButton"
                                Height="34"
                                Content="启动实验舱"
                                Foreground="White"
                                Background="#26834A"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="StartChamberButton_Click"/>
                        <Button x:Name="StopChamberButton"
                                Grid.Column="2"
                                Height="34"
                                Content="停止实验舱"
                                Foreground="White"
                                Background="#C65337"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="StopChamberButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="CommandStatusText"
                               Grid.Row="6"
                               Text="连接成功后可以设置温湿度并启停设备。"
                               Foreground="#718096"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <Border Grid.Row="8"
                            Background="#E6EBF2"/>

                    <TextBlock Grid.Row="10"
                               Text="部件状态（当前固件可能不提供）"
                               Foreground="#718096"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="压缩机"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="CompressorText"
                                       Text="--"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1">
                            <TextBlock Text="温度控制"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="TemperatureControlText"
                                       Text="--"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">
                            <TextBlock Text="湿度控制"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="HumidityControlText"
                                       Text="--"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="排水"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="DrainText"
                                       Text="--"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBlock Text="照明"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="LightText"
                                       Text="--"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="2">
                            <TextBlock Text="程序结束"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="ProgramEndText"
                                       Text="--"
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LastUpdateText"
                               Grid.Row="13"
                               Text="尚未收到设备数据"
                               Foreground="#8A97A9"
                               FontSize="11"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="4"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="报警监视"
                               Foreground="#17233A"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <Border Grid.Row="2"
                            Padding="10,6"
                            Background="#F0F3F7"
                            CornerRadius="6">
                        <TextBlock x:Name="TotalAlarmText"
                                   Text="报警状态：--"
                                   Foreground="#52627A"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="AlarmDetailsText"
                               Grid.Row="4"
                               Text="等待报警输入数据"
                               Foreground="#66758B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                    <TextBlock x:Name="MonitoringStatusText"
                               Grid.Row="5"
                               Text="正在建立实验舱连接…"
                               Foreground="#8A97A9"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
