<Window x:Class="ThermoVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermo Vision"
        Height="300"
        Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F8">
        <Border Width="320"
                Padding="28"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="运动控制"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <Button x:Name="SoftwareZeroButton"
                        Content="X 轴回零"
                        Height="46"
                        Margin="0,24,0,14"
                        FontSize="16"
                        Click="SoftwareZeroButton_Click"/>

                <TextBlock x:Name="MotionStatusText"
                           Text="等待操作"
                           Foreground="#59636E"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
