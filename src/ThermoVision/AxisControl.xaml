<UserControl x:Class="ThermoVision.AxisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ThermoVision"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#276EF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E5FD8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#164EBA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A9B7CC"/>
                                <Setter Property="Foreground"
                                        Value="#E9EEF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControllerNavigationStyle"
               TargetType="Button">
            <Setter Property="Height" Value="82"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#F4F7FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#142033"
                Padding="34,0">
            <Grid>
                <Button Width="78"
                        Height="34"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="#D7E1EF"
                        Background="#20314A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="← 返回"
                        Click="BackButton_Click"/>

                <StackPanel Margin="102,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="轴体控制"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="选择设备查看实时状态并执行回零"
                               Margin="0,5,0,0"
                               Foreground="#AEBBD0"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="StopAllButton"
                            Height="32"
                            Margin="0,0,12,0"
                            Padding="13,0"
                            Foreground="White"
                            Background="#B53A3A"
                            BorderThickness="0"
                            Cursor="Hand"
                            Content="全部停止"
                            Click="StopAllButton_Click"/>
                    <Border Padding="12,7"
                            Background="#20314A"
                            CornerRadius="14">
                        <TextBlock Text="状态刷新 200 ms"
                                   Foreground="#C8D4E5"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#DDE4ED"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Margin="4,2,0,14"
                               Text="设备列表"
                               Foreground="#6B798D"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Button x:Name="Controller1NavigationButton"
                            Tag="1"
                            Style="{StaticResource ControllerNavigationStyle}"
                            Click="ControllerNavigationButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    HorizontalAlignment="Left"
                                    Background="#EAF1FF"
                                    CornerRadius="7">
                                <TextBlock Text="01"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#276EF1"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="1 号轴"
                                           Foreground="#26354B"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal">
                                    <Ellipse x:Name="Controller1ConnectionDot"
                                             Width="7"
                                             Height="7"
                                             Margin="0,0,6,0"
                                             Fill="#98A5B7"/>
                                    <TextBlock x:Name="Controller1ConnectionText"
                                               Text="等待连接"
                                               Foreground="#758399"
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="Controller2NavigationButton"
                            Tag="2"
                            Style="{StaticResource ControllerNavigationStyle}"
                            Click="ControllerNavigationButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    HorizontalAlignment="Left"
                                    Background="#EAF1FF"
                                    CornerRadius="7">
                                <TextBlock Text="02"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#276EF1"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="2 号轴"
                                           Foreground="#26354B"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal">
                                    <Ellipse x:Name="Controller2ConnectionDot"
                                             Width="7"
                                             Height="7"
                                             Margin="0,0,6,0"
                                             Fill="#98A5B7"/>
                                    <TextBlock x:Name="Controller2ConnectionText"
                                               Text="等待连接"
                                               Foreground="#758399"
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="Controller3NavigationButton"
                            Tag="3"
                            Style="{StaticResource ControllerNavigationStyle}"
                            Click="ControllerNavigationButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    HorizontalAlignment="Left"
                                    Background="#EAF1FF"
                                    CornerRadius="7">
                                <TextBlock Text="03"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#276EF1"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="3 号轴"
                                           Foreground="#26354B"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal">
                                    <Ellipse x:Name="Controller3ConnectionDot"
                                             Width="7"
                                             Height="7"
                                             Margin="0,0,6,0"
                                             Fill="#98A5B7"/>
                                    <TextBlock x:Name="Controller3ConnectionText"
                                               Text="等待连接"
                                               Foreground="#758399"
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="26,22"
                    Background="White"
                    BorderBrush="#DDE4ED"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="SelectedControllerTitle"
                                       Text="1 号轴"
                                       Foreground="#17233A"
                                       FontSize="24"
                                       FontWeight="SemiBold"/>
                            <StackPanel Margin="0,7,0,0"
                                        Orientation="Horizontal">
                                <TextBlock x:Name="SelectedControllerIpText"
                                           Text="192.168.1.31"
                                           Foreground="#6E7D91"
                                           FontSize="12"/>
                                <TextBlock Margin="12,0"
                                           Text="·"
                                           Foreground="#A7B1BF"/>
                                <Ellipse x:Name="SelectedControllerConnectionDot"
                                         Width="8"
                                         Height="8"
                                         Margin="0,0,7,0"
                                         Fill="#98A5B7"/>
                                <TextBlock x:Name="SelectedControllerConnectionText"
                                           Text="等待连接"
                                           Foreground="#758399"
                                           FontSize="12"/>
                                <TextBlock Margin="12,0"
                                           Text="·"
                                           Foreground="#A7B1BF"/>
                                <TextBlock x:Name="SelectedControllerAxesText"
                                           Text="X / Y"
                                           Foreground="#6E7D91"
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="SelectedControllerHomeButton"
                                    Width="128"
                                    Margin="0,0,8,0"
                                    Content="当前轴回零"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ControllerZeroButton_Click"/>
                            <Button x:Name="SelectedControllerRangeButton"
                                    Width="152"
                                    Content="标定负限位/行程"
                                    IsEnabled="False"
                                    ToolTip="回零后依次低速寻找各轴负限位并保存最大行程"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ControllerRangeButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            VerticalAlignment="Center"
                            BorderBrush="#E5EAF1"
                            BorderThickness="0,1,0,0"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="0,0,0,8"
                                       Text="实时轴状态"
                                       Foreground="#6B798D"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <local:AxisStatusControl x:Name="SelectedXStatus"
                                                     AxisName="X"/>
                            <local:AxisStatusControl x:Name="SelectedYStatus"
                                                     AxisName="Y"/>
                            <local:AxisStatusControl x:Name="SelectedZStatus"
                                                     AxisName="Z"
                                                     Visibility="Collapsed"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Padding="15,12"
                                Background="#F8FAFD"
                                BorderBrush="#E1E7EF"
                                BorderThickness="1"
                                CornerRadius="8">
                            
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                                Text="操作轴"
                                                Foreground="#58677D"
                                                FontSize="11"/>
                                    <ComboBox x:Name="OperationAxisComboBox"
                                                Grid.Column="1"
                                                Height="28"
                                                Margin="12,0,0,0"
                                                SelectionChanged="OperationAxisComboBox_SelectionChanged"/>
                                </Grid>

                                <TextBlock x:Name="OperationReadinessText"
                                            Margin="0,8,0,8"
                                            Text="请选择并完成回零与软件限位配置"
                                            Foreground="#A96800"
                                            FontSize="10"
                                            TextWrapping="Wrap"/>

                                <TextBlock Text="步进移动（软件坐标）"
                                            Foreground="#58677D"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>
                                <Grid Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="StepDistanceTextBox"
                                                Height="30"
                                                VerticalContentAlignment="Center"
                                                Text="1.000"/>
                                    <Button x:Name="NegativeStepButton"
                                            Grid.Column="2"
                                            Height="30"
                                            Content="− 移动"
                                            Tag="-1"
                                            IsEnabled="False"
                                            Click="RelativeMoveButton_Click"/>
                                    <Button x:Name="PositiveStepButton"
                                            Grid.Column="4"
                                            Height="30"
                                            Content="+ 移动"
                                            Tag="1"
                                            IsEnabled="False"
                                            Click="RelativeMoveButton_Click"/>
                                </Grid>

                                <TextBlock Text="目标位置（软件坐标）"
                                            Foreground="#58677D"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>
                                <Grid Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TargetPositionTextBox"
                                                Height="30"
                                                VerticalContentAlignment="Center"/>
                                    <Button x:Name="MoveToTargetButton"
                                            Grid.Column="2"
                                            Height="30"
                                            Content="移动到目标"
                                            IsEnabled="False"
                                            Click="MoveToTargetButton_Click"/>
                                </Grid>

                                <TextBlock Text="软件限位"
                                            Foreground="#58677D"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LimitMinimumTextBox"
                                                Height="30"
                                                ToolTip="最小软件坐标，不能小于30（正限位安全余量）"
                                                VerticalContentAlignment="Center"/>
                                    <TextBox x:Name="LimitMaximumTextBox"
                                                Grid.Column="2"
                                                Height="30"
                                                ToolTip="最大软件坐标，不能超过标定行程减30（负限位安全余量）"
                                                VerticalContentAlignment="Center"/>
                                    <Button x:Name="SaveLimitsButton"
                                            Grid.Column="4"
                                            Height="30"
                                            Content="保存范围"
                                            Click="SaveLimitsButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4"
                            Padding="15,11"
                            Background="#F5F8FC"
                            BorderBrush="#E1E7EF"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#7E8CA1"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="MotionStatusText"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Text="等待操作"
                                       Foreground="#596A82"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
