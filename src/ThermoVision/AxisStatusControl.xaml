<UserControl x:Class="ThermoVision.AxisStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="58"
             Margin="0,0,0,8">
    <Border Padding="14,0"
            Background="#FAFBFD"
            BorderBrush="#E1E7EF"
            BorderThickness="1"
            CornerRadius="7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="AxisNameText"
                       VerticalAlignment="Center"
                       Foreground="#26354B"
                       FontSize="15"
                       FontWeight="Bold"/>

            <TextBlock x:Name="PositionText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#3E4D63"
                       FontSize="13"
                       Text="P --"/>

            <TextBlock x:Name="SpeedText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#6E7D91"
                       FontSize="12"
                       Text="V --"/>

            <Border x:Name="StateBorder"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="7,3"
                    Background="#F0F3F7"
                    CornerRadius="8">
                <TextBlock x:Name="StateText"
                           Text="等待"
                           Foreground="#758399"
                           FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
